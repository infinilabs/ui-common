{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./.tsbuild-node",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
