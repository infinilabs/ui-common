  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "unocss": "^66.5.10",
    "vite": "^7.2.4",
    "vite-plugin-css-injected-by-js": "^3.5.2",
