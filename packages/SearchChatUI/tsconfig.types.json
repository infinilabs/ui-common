{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/components/**/*",
    "src/features/**/*",
    "src/i18n/**/*",
    "src/lib/**/*",
    "src/hooks/**/*",
    "src/styles/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "src/main.tsx",
    "index.html",
    "public/**"
  ]
}
